{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.invalid/protocol/0.2/frame.schema.json",
  "title": "Orbit 0.2.0 - tramas CBOR servidor <-> telefono <-> reloj (forma JSON)",
  "description": "Representacion JSON de cada trama CBOR. Arrays JSON = arrays CBOR definidos; enteros = uint CBOR de longitud minima; strings = text string UTF-8; {\"$hex\": ...} = byte string CBOR. No hay mapas ni floats en 0.2.0. Ver SPEC 5 y 6.",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/delta"
    },
    {
      "$ref": "#/$defs/req"
    },
    {
      "$ref": "#/$defs/perm"
    },
    {
      "$ref": "#/$defs/pclose"
    },
    {
      "$ref": "#/$defs/dec"
    },
    {
      "$ref": "#/$defs/say"
    },
    {
      "$ref": "#/$defs/text"
    }
  ],
  "$defs": {
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "u53": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "ref": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "id de nodo o 0 = ninguno"
    },
    "label": {
      "type": "string",
      "maxLength": 32,
      "description": "<= 32 bytes UTF-8 (cortado en frontera de code point)"
    },
    "nodeType": {
      "enum": [
        "session",
        "agent",
        "task",
        "mcp"
      ]
    },
    "status": {
      "enum": [
        "run",
        "perm",
        "done",
        "err"
      ]
    },
    "decision": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "bytes": {
      "type": "object",
      "required": [
        "$hex"
      ],
      "additionalProperties": false,
      "properties": {
        "$hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        }
      }
    },
    "nonce": {
      "allOf": [
        {
          "$ref": "#/$defs/bytes"
        }
      ],
      "properties": {
        "$hex": {
          "minLength": 32,
          "maxLength": 32
        }
      }
    },
    "kid": {
      "allOf": [
        {
          "$ref": "#/$defs/bytes"
        }
      ],
      "properties": {
        "$hex": {
          "minLength": 16,
          "maxLength": 16
        }
      }
    },
    "sig": {
      "allOf": [
        {
          "$ref": "#/$defs/bytes"
        }
      ],
      "properties": {
        "$hex": {
          "minLength": 128,
          "maxLength": 128
        }
      }
    },
    "ph": {
      "allOf": [
        {
          "$ref": "#/$defs/bytes"
        }
      ],
      "properties": {
        "$hex": {
          "minLength": 64,
          "maxLength": 64
        }
      },
      "description": "SHA-256 (32 bytes) del CBOR determinista de [\"orbit-perm\", 1, instance_id, nonce, tool_use_id, tool, sum, wok, exp] (SPEC 6.3)."
    },
    "sid": {
      "allOf": [
        {
          "$ref": "#/$defs/bytes"
        }
      ],
      "properties": {
        "$hex": {
          "minLength": 32,
          "maxLength": 32
        }
      },
      "description": "Identificador de sesion (0.2.2, SPEC 6.6): primeros 16 bytes de SHA-256 del CBOR determinista de [\"orbit-sid\", 1, instance_id, session_id]. El servidor lo da al reloj en info de GET /v0/transcript; el mod lo recalcula desde su session_id."
    },
    "instanceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "toolUseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "hello": {
      "description": "[\"hello\", version, epoch, seq] - primera trama de cada conexion servidor->telefono.",
      "type": "array",
      "prefixItems": [
        {
          "const": "hello"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        {
          "$ref": "#/$defs/u32"
        },
        {
          "$ref": "#/$defs/u53"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "delta": {
      "description": "[\"d\", epoch, seq, ts, [op...]] - ts en segundos Unix.",
      "type": "array",
      "prefixItems": [
        {
          "const": "d"
        },
        {
          "$ref": "#/$defs/u32"
        },
        {
          "$ref": "#/$defs/u53"
        },
        {
          "$ref": "#/$defs/u53"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          }
        }
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "op": {
      "oneOf": [
        {
          "$ref": "#/$defs/opSnap"
        },
        {
          "$ref": "#/$defs/opAdd"
        },
        {
          "$ref": "#/$defs/opSt"
        },
        {
          "$ref": "#/$defs/opRm"
        },
        {
          "$ref": "#/$defs/opMeta"
        },
        {
          "$ref": "#/$defs/opStuck"
        }
      ]
    },
    "opSnap": {
      "description": "[\"snap\", [node...]] - sustituye el grafo entero. node = [id, t, p, s, k, m, ts]; m=0 = sin MCP.",
      "type": "array",
      "prefixItems": [
        {
          "const": "snap"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "node": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "$ref": "#/$defs/nodeType"
        },
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/status"
        },
        {
          "$ref": "#/$defs/label"
        },
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/u53"
        }
      ],
      "minItems": 7,
      "maxItems": 7
    },
    "opAdd": {
      "description": "[\"add\", id, t, p, k] o [\"add\", id, t, p, k, m]. Estado inicial implicito: run.",
      "type": "array",
      "prefixItems": [
        {
          "const": "add"
        },
        {
          "$ref": "#/$defs/id"
        },
        {
          "$ref": "#/$defs/nodeType"
        },
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/label"
        },
        {
          "$ref": "#/$defs/id"
        }
      ],
      "minItems": 5,
      "maxItems": 6
    },
    "opSt": {
      "type": "array",
      "prefixItems": [
        {
          "const": "st"
        },
        {
          "$ref": "#/$defs/id"
        },
        {
          "$ref": "#/$defs/status"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "opRm": {
      "description": "[\"rm\", id] - borra el nodo y, en cascada, todos sus descendientes.",
      "type": "array",
      "prefixItems": [
        {
          "const": "rm"
        },
        {
          "$ref": "#/$defs/id"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "opMeta": {
      "description": "[\"meta\", session_id_corto, in_tok, out_tok, turns] - totales acumulados de la sesion.",
      "type": "array",
      "prefixItems": [
        {
          "const": "meta"
        },
        {
          "$ref": "#/$defs/id"
        },
        {
          "$ref": "#/$defs/u53"
        },
        {
          "$ref": "#/$defs/u53"
        },
        {
          "$ref": "#/$defs/u32"
        }
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "stuckWhy": {
      "enum": [
        "idle",
        "loop",
        "none"
      ]
    },
    "opStuck": {
      "description": "[\"stuck\", session, why, since, k, n] (0.2.3, SPEC 4.5) - la sesion esta atascada: idle = sin eventos demasiado tiempo, loop = la misma herramienta con la misma entrada n veces seguidas; none = ya no. since en segundos Unix (0 con none); k = etiqueta de la herramienta (\"\" si no hay); n = repeticiones (0 con idle/none). Informativa: un cliente que no la conoce la ignora (SPEC 5.3).",
      "type": "array",
      "prefixItems": [
        {
          "const": "stuck"
        },
        {
          "$ref": "#/$defs/id"
        },
        {
          "$ref": "#/$defs/stuckWhy"
        },
        {
          "$ref": "#/$defs/u53"
        },
        {
          "$ref": "#/$defs/label"
        },
        {
          "$ref": "#/$defs/u32"
        }
      ],
      "minItems": 6,
      "maxItems": 6
    },
    "req": {
      "description": "[\"req\", \"snap\", epoch, last_seq] - reloj/telefono -> aguas arriba.",
      "type": "array",
      "prefixItems": [
        {
          "const": "req"
        },
        {
          "const": "snap"
        },
        {
          "$ref": "#/$defs/u32"
        },
        {
          "$ref": "#/$defs/u53"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "perm": {
      "description": "[\"perm\", nonce, tool_use_id, id, exp, tool, sum, wok, instance_id] - solicitud de permiso. exp en segundos Unix. wok=false: el reloj solo puede denegar. instance_id: instancia que pide el permiso; entra en ph (SPEC 6.3) y el reloj la muestra.",
      "type": "array",
      "prefixItems": [
        {
          "const": "perm"
        },
        {
          "$ref": "#/$defs/nonce"
        },
        {
          "$ref": "#/$defs/toolUseId"
        },
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/u53"
        },
        {
          "$ref": "#/$defs/label"
        },
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/instanceId"
        }
      ],
      "minItems": 9,
      "maxItems": 9
    },
    "pclose": {
      "description": "[\"pclose\", nonce, by, decision] - el permiso ya se resolvio; el reloj retira la solicitud.",
      "type": "array",
      "prefixItems": [
        {
          "const": "pclose"
        },
        {
          "$ref": "#/$defs/nonce"
        },
        {
          "enum": [
            "watch",
            "terminal",
            "timeout",
            "rule",
            "abort"
          ]
        },
        {
          "enum": [
            "allow",
            "deny",
            "none"
          ]
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "dec": {
      "description": "[\"dec\", nonce, tool_use_id, decision, ts, kid, sig, ph] - decision firmada (reloj -> mod). ts en segundos Unix. sig = ECDSA P-256/SHA-256, r||s de 64 bytes, sobre CBOR determinista de [\"orbit-dec\", 2, nonce, tool_use_id, decision, ts, ph] (formato de firma 2). ph viaja para diagnostico: el mod lo recalcula desde su pendiente y no se fia del recibido.",
      "type": "array",
      "prefixItems": [
        {
          "const": "dec"
        },
        {
          "$ref": "#/$defs/nonce"
        },
        {
          "$ref": "#/$defs/toolUseId"
        },
        {
          "$ref": "#/$defs/decision"
        },
        {
          "$ref": "#/$defs/u53"
        },
        {
          "$ref": "#/$defs/kid"
        },
        {
          "$ref": "#/$defs/sig"
        },
        {
          "$ref": "#/$defs/ph"
        }
      ],
      "minItems": 8,
      "maxItems": 8
    },
    "say": {
      "description": "[\"say\", nonce, ts, instance_id, sid, kind, text, kid, sig] - respuesta firmada del reloj (reloj -> mod, formato de say 2, SPEC 6.6). ts en segundos Unix. sig = ECDSA P-256/SHA-256, r||s de 64 bytes, sobre CBOR determinista de [\"orbit-say\", 2, nonce, ts, instance_id, sid, kind, text]. El formato 1 (8 elementos, sin sid) ya no se acepta. text <= 1000 bytes UTF-8 (el schema solo acota caracteres).",
      "type": "array",
      "prefixItems": [
        {
          "const": "say"
        },
        {
          "$ref": "#/$defs/nonce"
        },
        {
          "$ref": "#/$defs/u53"
        },
        {
          "$ref": "#/$defs/instanceId"
        },
        {
          "$ref": "#/$defs/sid"
        },
        {
          "enum": [
            "text",
            "stop",
            "recap"
          ]
        },
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "$ref": "#/$defs/kid"
        },
        {
          "$ref": "#/$defs/sig"
        }
      ],
      "minItems": 9,
      "maxItems": 9
    },
    "text": {
      "description": "[\"text\", epoch, id, f, text, trunc, red] - respuesta de GET /v0/text (SPEC 8). Nunca viaja como delta.",
      "type": "array",
      "prefixItems": [
        {
          "const": "text"
        },
        {
          "$ref": "#/$defs/u32"
        },
        {
          "$ref": "#/$defs/id"
        },
        {
          "enum": [
            "cmd",
            "prompt",
            "answer",
            "result",
            "reason"
          ]
        },
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "boolean"
        },
        {
          "type": "boolean"
        }
      ],
      "minItems": 7,
      "maxItems": 7
    }
  }
}
