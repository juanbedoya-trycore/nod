{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.invalid/protocol/0.2/hook-payload.schema.json",
  "title": "Orbit 0.2.0 - payload canonico de evento (forma de hook de Claude Code)",
  "description": "Cuerpo de un evento crudo. Con src=hook es el POST tal cual lo envia Claude Code 2.1.296. Con src=mod el mod traduce los eventos del motor a esta misma forma (SPEC.md 3.3). Campos desconocidos se aceptan y se conservan (compatibilidad hacia delante). Los textos son opcionales porque ctx=work los elimina.",
  "type": "object",
  "required": ["session_id", "hook_event_name"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "hook_event_name": {
      "enum": [
        "SessionStart", "UserPromptSubmit", "PreToolUse", "PermissionRequest", "PostToolUse",
        "PostToolUseFailure", "SubagentStart", "SubagentStop", "Stop", "SessionEnd",
        "TaskCreated", "TaskCompleted", "Notification"
      ],
      "x-unverified": ["SessionStart", "PostToolUseFailure", "TaskCreated", "TaskCompleted", "Notification"]
    },
    "transcript_path": { "type": "string" },
    "agent_transcript_path": { "type": "string" },
    "cwd": { "type": "string" },
    "prompt_id": { "type": "string" },
    "turn_id": { "type": "string", "description": "Solo src=mod (turnId del motor). Relacion con prompt_id sin verificar." },
    "permission_mode": { "type": "string" },
    "effort": {
      "type": "object",
      "properties": { "level": { "type": "string" } }
    },
    "agent_id": { "type": "string", "minLength": 1 },
    "agent_type": { "type": "string" },
    "tool_name": { "type": "string", "minLength": 1 },
    "tool_input": { "type": "object" },
    "tool_response": {},
    "tool_use_id": { "type": "string", "minLength": 1 },
    "parent_tool_use_id": { "type": "string", "minLength": 1, "description": "Solo src=mod: tool_use_id del tool Agent que lanzo el subagente." },
    "background": { "type": "boolean" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "is_error": { "type": "boolean" },
    "is_aborted": { "type": "boolean" },
    "permission_suggestions": { "type": "array" },
    "permission_reason": { "type": "string", "description": "Solo src=mod: reason del veredicto 'ask' de tool.check (texto)." },
    "prompt": { "type": "string" },
    "last_assistant_message": { "type": "string" },
    "stop_hook_active": { "type": "boolean" },
    "background_tasks": { "type": "array" },
    "session_crons": { "type": "array" },
    "reason": { "type": "string" },
    "source": { "type": "string" }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": { "properties": { "hook_event_name": { "const": "PreToolUse" } } },
      "then": { "required": ["tool_name", "tool_use_id"] }
    },
    {
      "if": { "properties": { "hook_event_name": { "enum": ["PostToolUse", "PostToolUseFailure"] } } },
      "then": { "required": ["tool_name", "tool_use_id"] }
    },
    {
      "if": { "properties": { "hook_event_name": { "const": "PermissionRequest" } } },
      "then": {
        "required": ["tool_name"],
        "description": "Con src=hook NO trae tool_use_id (fixture PermissionRequest-1); se empareja con el PreToolUse previo (SPEC 4.3)."
      }
    },
    {
      "if": { "properties": { "hook_event_name": { "const": "SubagentStart" } } },
      "then": { "required": ["agent_id", "agent_type"] }
    },
    {
      "if": { "properties": { "hook_event_name": { "const": "SubagentStop" } } },
      "then": { "required": ["agent_id"] }
    },
    {
      "if": { "properties": { "hook_event_name": { "const": "SessionEnd" } } },
      "then": { "required": ["reason"] }
    }
  ]
}
